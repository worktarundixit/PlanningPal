# Postgres
# Local docker-compose uses one database for queries and migrations.
# Leave DIRECT_DATABASE_URL unset locally; it falls back to DATABASE_URL.
DATABASE_URL=postgres://planningpal:planningpal@localhost:5432/planningpal
# DIRECT_DATABASE_URL=postgres://planningpal:planningpal@localhost:5432/planningpal

# --- Neon (production) ---
# Create a project at https://console.neon.tech, then copy both connection strings
# from the dashboard (Connection details → show pooled / direct).
# Do not commit real credentials. sslmode=require is required.
#
# Pooled (PgBouncer, hostname contains -pooler). The API uses this.
# Prepared statements are turned off automatically for the pooler.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Direct (no -pooler). Migrations use this. Session features and the migration
# lock do not work through the pooler.
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require
#
# Optional pool size for the API process. Ignored by migrations (those use 1 connection).
# DATABASE_POOL_MAX=10

# API
API_PORT=3001
API_HOST=0.0.0.0

# strict: telemetry requires TELEMETRY_SECRET. Session auth does not use this flag.
AUTH_MODE=dev

# Better Auth. BETTER_AUTH_URL is the origin the browser uses (the Vite dev server,
# which proxies /api). Set a long random secret outside local development.
BETTER_AUTH_SECRET=dev-planningpal-auth-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173

# Google and Microsoft sign-in stay disabled until both id and secret are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# HMAC secret for POST /api/v1/telemetry/event (X-AEC-Signature).
# When empty and AUTH_MODE=dev, signature checks are skipped.
TELEMETRY_SECRET=

# Web
WEB_PORT=5173
# Leave empty in local dev so Vite proxies /api to the API.
VITE_API_URL=
