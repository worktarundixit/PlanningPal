# Copy to .env. Do not commit .env or real keys.

# --- Supabase ---
# Create a project at https://supabase.com/dashboard in eu-west-2 (London).
# Vercel functions run in lhr1. Project Settings → API: Project URL, anon key, service_role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same public values, baked into the browser bundle. Set them in Vercel too.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Postgres. Local docker-compose uses one database for queries and migrations.
# Leave DIRECT_DATABASE_URL unset locally; it falls back to DATABASE_URL.
DATABASE_URL=postgres://planningpal:planningpal@localhost:5432/planningpal
# DIRECT_DATABASE_URL=postgres://planningpal:planningpal@localhost:5432/planningpal

# Supabase Postgres (production):
# DATABASE_URL is the transaction pooler (port 6543, host pooler.supabase.com).
# The API uses it. Prepared statements are turned off for that pooler.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require
#
# DIRECT_DATABASE_URL is the session connection (port 5432). Migrations use it.
# DIRECT_DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
#
# DATABASE_POOL_MAX=10

# Product email (lead alerts and team invites). Auth emails stay in Supabase.
# Leave RESEND_API_KEY empty locally; messages are logged and stored in mail_log.
RESEND_API_KEY=
# RESEND_FROM=PlanningPal <alerts@planningpal.co.uk>

# Campaign engine. Leave the agency key out of the browser.
# CAMPAIGN_PROVIDER=sandbox forces the in-memory engine even when a key is saved.
# CAMPAIGN_PROVIDER=sandbox
# AES-256-GCM secret used to encrypt the agency key at rest. Required before a live key can be saved.
CAMPAIGN_KEY_ENCRYPTION_SECRET=
# Shared secret for /api/v1/campaign-events/:token and the x-campaign-webhook-token header.
CAMPAIGN_WEBHOOK_SECRET=

# Shared with the Supabase Vault secret named cron_secret.
# pg_cron sends Authorization: Bearer $CRON_SECRET. The ingest route rejects any other call.
CRON_SECRET=
# Milliseconds of PlanIt work per cron invocation. Stay under the function limit.
# INGEST_BUDGET_MS=45000

# API
API_PORT=3001
API_HOST=0.0.0.0

# strict: telemetry requires TELEMETRY_SECRET.
AUTH_MODE=dev

# Browser origin allowed to call the API with credentials.
WEB_ORIGIN=http://127.0.0.1:5173

# HMAC secret for POST /api/v1/telemetry/event (X-AEC-Signature).
# When empty and AUTH_MODE=dev, signature checks are skipped.
TELEMETRY_SECRET=

# Web
WEB_PORT=5173
# Leave empty in local dev so Vite proxies /api to the API.
VITE_API_URL=
