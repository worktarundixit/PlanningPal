{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "crons": [
    { "path": "/api/cron/ingest", "schedule": "0 5,6 * * *" },
    { "path": "/api/cron/ingest", "schedule": "0 12,13 * * *" },
    { "path": "/api/cron/ingest", "schedule": "0 19,20 * * *" }
  ],
  "functions": {
    "api/cron/ingest.ts": { "maxDuration": 60 },
    "api/[...path].ts": { "maxDuration": 30 }
  }
}
